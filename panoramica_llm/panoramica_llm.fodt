     <text:p text:style-name="P69"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc97_447025415" office:name="L’idea essenziale" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">L’idea essenziale<text:tab/>1</text:a></text:p>
     <text:p text:style-name="P69"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc99_447025415" office:name="Fasi operative" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">Fasi operative<text:tab/>2</text:a></text:p>
     <text:p text:style-name="P70"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc101_447025415" office:name="Il testo viene diviso in token" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">Il testo viene diviso in <text:span text:style-name="T6">token</text:span><text:tab/>2</text:a></text:p>
     <text:p text:style-name="P70"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc103_447025415" office:name="I numeri diventano vettori" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">I numeri diventano vettori<text:tab/>3</text:a></text:p>
     <text:p text:style-name="P70"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc105_447025415" office:name="Il transformer analizza le relazioni" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">Il <text:span text:style-name="T6">t</text:span><text:span text:style-name="T6">ransformer</text:span> analizza le relazioni<text:tab/>5</text:a></text:p>
     <text:p text:style-name="P70"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc107_447025415" office:name="Come viene addestrato" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">Come viene addestrato<text:tab/>6</text:a></text:p>
     <text:p text:style-name="P70"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc109_447025415" office:name="Che cosa impara realmente?" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">Che cosa impara realmente?<text:tab/>6</text:a></text:p>
     <text:p text:style-name="P70"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc111_447025415" office:name="Come genera una risposta" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">Come genera una risposta<text:tab/>7</text:a></text:p>
     <text:p text:style-name="P70"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc113_447025415" office:name="Perché non sceglie sempre il token più probabile?" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">Perché non sceglie sempre il <text:span text:style-name="T6">token</text:span> più probabile?<text:tab/>8</text:a></text:p>
     <text:p text:style-name="P70"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc115_447025415" office:name="Perché sembra seguire istruzioni?" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">Perché sembra seguire istruzioni?<text:tab/>8</text:a></text:p>
     <text:p text:style-name="P70"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc117_447025415" office:name="Sta ragionando oppure sta solo completando testo?" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">Sta ragionando oppure sta solo completando testo?<text:tab/>9</text:a></text:p>
     <text:p text:style-name="P70"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc119_447025415" office:name="Perché può inventare informazioni?" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">Perché può inventare informazioni?<text:tab/>10</text:a></text:p>
     <text:p text:style-name="P70"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc121_447025415" office:name="Contesto e memoria non sono la stessa cosa" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">Contesto e memoria non sono la stessa cosa<text:tab/>10</text:a></text:p>
     <text:p text:style-name="P70"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc1129_447025415" office:name="Il modello in una formula" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">Il modello in una formula<text:tab/>11</text:a></text:p>
     <text:p text:style-name="P69"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc127_447025415" office:name="Riassunto finale" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">Riassunto finale<text:tab/>12</text:a></text:p>
