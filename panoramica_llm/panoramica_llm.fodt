           <mrow>
            <mtext>Roma</mtext>
           </mrow>
           <mo fence="true" form="postfix" stretchy="true">)</mo>
          </mrow>
          <mo stretchy="false">=</mo>
          <mn>0,01</mn>
         </mrow>
        </mrow>
        <annotation encoding="StarMath 5.0">P left( &quot;Roma&quot; right) = 0,01</annotation>
       </semantics>
      </math>
     </draw:object><draw:image>
