   <text:p text:style-name="P3"><text:span text:style-name="T36">l</text:span><text:span text:style-name="T32">a perdita complessiva è normalmente la media:</text:span></text:p>
   <text:p text:style-name="P14"><draw:frame draw:style-name="fr3" draw:name="Object16" text:anchor-type="as-char" svg:y="-0.716cm" svg:width="5.771cm" svg:height="1.148cm" draw:z-index="16"><draw:object>
