   <text:p text:style-name="P38">avremmo:</text:p>
   <text:p text:style-name="P41"><draw:frame draw:style-name="fr3" draw:name="Object11" text:anchor-type="as-char" svg:y="-0.406cm" svg:width="3.646cm" svg:height="0.522cm" draw:z-index="11"><draw:object>
