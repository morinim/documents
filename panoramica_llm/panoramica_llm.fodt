   <text:p text:style-name="P3">ossia la probabilità del prossimo <text:span text:style-name="T6">token</text:span> (<draw:frame draw:style-name="fr3" draw:name="Object7" text:anchor-type="as-char" svg:y="-0.379cm" svg:width="0.593cm" svg:height="0.534cm" draw:z-index="33"><draw:object>
