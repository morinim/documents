          <mi>L</mi>
          <mo stretchy="false">=</mo>
          <mrow>
           <mn>1</mn>
           <mo stretchy="false">−</mo>
           <mi>P</mi>
          </mrow>
         </mrow>
         <mrow>
          <mo fence="true" form="prefix" stretchy="true">(</mo>
          <mrow>
           <mtext>token corretto</mtext>
          </mrow>
          <mo fence="true" form="postfix" stretchy="true">)</mo>
         </mrow>
        </mrow>
        <annotation encoding="StarMath 5.0">L = 1 - P left( &quot;token corretto&quot; right)</annotation>
       </semantics>
      </math>
     </draw:object><draw:image>
