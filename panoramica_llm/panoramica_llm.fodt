            <mi>x</mi>
           </mstyle>
          </mrow>
          <mo fence="true" form="postfix" stretchy="true">)</mo>
         </mrow>
        </mrow>
        <annotation encoding="StarMath 5.0">bold y = bold x + F left( bold x right)</annotation>
       </semantics>
      </math>
     </draw:object><draw:image>
