      <text:p text:style-name="P44">0,105</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="TableProbabilitàPerdita.A4" office:value-type="float" office:value="0.5">
      <text:p text:style-name="P43">0,500</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="TableProbabilitàPerdita.B4" office:value-type="float" office:value="0.693">
